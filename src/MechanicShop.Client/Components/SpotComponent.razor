<span class="badge fs-4"><i class="bi bi-circle-fill me-2 @GetSpotColor(Spot)"></i>@Spot.ToString()</span>

@code {

    [Parameter]
    public Spots Spot { get; set; }

    private string GetSpotColor(Spots spotNumber)
    {
        return spotNumber switch
        {
            Spots.A => "text-primary",
            Spots.B => "text-danger",
            Spots.C => "text-success",
            Spots.D => "text-warning",
            _ => throw new ArgumentOutOfRangeException()
        };
    }
}
